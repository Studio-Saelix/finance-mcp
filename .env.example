# Studio Saelix Finance MCP — isolated development configuration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=US
PLAID_CLIENT_NAME=Studio Saelix Finance MCP
PLAID_MCP_DB=~/.plaid-mcp/plaid.db

# Optional webhook configuration is reserved for administrator workflows.
# PLAID_WEBHOOK_URL=

# Runtime MCP is stdio-only and Plaid-only.
PROVIDER=plaid
