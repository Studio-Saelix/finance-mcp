# Studio Saelix Finance MCP — development/test-only environment overrides.
# Production operation reads non-secret configuration from:
#   ~/.config/studio-saelix-finance/config.toml
# Plaid credentials are captured by `studio-saelix-finance init` and encrypted
# inside finance.db. Do not place real credentials in this file or Hermes.

PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=CA
PLAID_CLIENT_NAME=Studio Saelix Finance MCP
PROVIDER=plaid

# Test-only escape hatch; never set this in Hermes or a normal deployment.
# PLAID_MCP_ALLOW_ENV_SECRETS=1
# PLAID_CLIENT_ID=placeholder
# PLAID_SECRET=placeholder
